[sub_resource type="Shader" id="Shader_fo6qg"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.6.1.stable.mono's StandardMaterial3D.
// added code is noted by comments

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

// added parameters
uniform float scale_1;
uniform float scale_2;
uniform float angle_offset : hint_range(0.0, 359.9);
uniform sampler2D height_map : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float max_height_offset;
// end of added parameters

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform sampler2D texture_normal : hint_roughness_normal, filter_linear_mipmap, repeat_enable;
uniform float normal_scale : hint_range(-16.0, 16.0);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
	// added code
	float height_1 = texture(height_map, UV * scale_1).r;
	height_1 = height_1 * 2.0 - 1.0;
	float angle = radians(angle_offset);
	float s = sin(angle);
	float c = cos(angle);
	vec2 centered_uv = UV - 0.5;
	vec2 rotated_uv = vec2(
		centered_uv.x * c - centered_uv.y * s,
		centered_uv.x * s + centered_uv.y * c
	);
	float height_2 = texture(height_map, rotated_uv * scale_2).r;
	height_2 = height_2 * 2.0 - 1.0;
	float height = mix(height_1, height_2, 0.5);
	VERTEX += vec3(0.0, 1.0, 0.0) * height * max_height_offset;
	// end of added code
}

void fragment() {
	// added code
	// mix the same texture - different scale and rotation
	vec2 base_uv = UV;
	vec4 albedo_1 = texture(texture_albedo, base_uv * scale_1);
	float angle = radians(angle_offset);
	float s = sin(angle);
	float c = cos(angle);
	vec2 centered_uv = base_uv - 0.5;
	vec2 rotated_uv = vec2(
		centered_uv.x * c - centered_uv.y * s,
		centered_uv.x * s + centered_uv.y * c
	);
	vec4 albedo_2 = texture(texture_albedo, rotated_uv * scale_2);
	ALBEDO = mix(albedo_1, albedo_2, 0.5).rgb;
	
	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	float roughness_tex_1 = dot(texture(texture_roughness, base_uv * scale_1), roughness_texture_channel);
	float roughness_tex_2 = dot(texture(texture_roughness, rotated_uv * scale_2), roughness_texture_channel);
	ROUGHNESS = mix(roughness_tex_1, roughness_tex_2, 0.5) * roughness;
	
	// Normal Map: Enabled
	vec3 normal_1 = texture(texture_normal, base_uv * scale_1).rgb;
	vec3 normal_2 = texture(texture_normal, rotated_uv * scale_2).rgb;
	NORMAL_MAP = mix(normal_1, normal_2, 0.5);
	NORMAL_MAP_DEPTH = normal_scale;
	// end of added code
	
	SPECULAR = specular;
}
"

